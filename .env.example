# FleetOps AI — environment variables
# Copy this file to .env.local and fill in as needed.
# Mock mode (default) runs with zero keys.

# ---- Mock / live switch ----
# When true, ScannerAgent uses the bundled AcmeCorp snapshot. Policy evaluation
# and remediation drafting are deterministic in both modes.
# Set false to call live Cloud Asset Inventory using ADC.
FLEETOPS_MOCK=true

# ---- Live Cloud Asset Inventory ----
# Comma-separated project allowlist. The ADC identity needs
# roles/cloudasset.viewer on each project.
GCP_PROJECT_IDS=

# Optional comma-separated name fragments. Only matching fixtures enter the
# policy pipeline; useful when scanning a shared sandbox project.
FLEETOPS_RESOURCE_FILTER=

# For local service-account auth, use the standard Google ADC variable:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# ---- Safety switch for real gcloud writes ----
# This must remain false. RemediationAgent shows the command it would run but
# never executes it against the target project.
FLEETOPS_ALLOW_REAL_REMEDIATION=false
