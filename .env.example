# FleetOps AI — environment variables
# Copy this file to .env.local and fill in as needed.
# Mock mode (default) runs with zero keys.

# ---- Mock / live switch ----
# When true, all 3 agents use the bundled AcmeCorp snapshot + deterministic
# policy reasoning + drafted remediations. Zero API keys needed.
# Set false to call live Gemini + (optionally) live Cloud Asset Inventory.
FLEETOPS_MOCK=true

# ---- Gemini (live PolicyAgent + RemediationAgent) ----
# Free key at https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# ---- Live Cloud Asset Inventory (optional; replaces bundled snapshot) ----
# Only set if you want ScannerAgent to hit real GCP.
# The service account needs `roles/cloudasset.viewer` on the org.
GCP_SERVICE_ACCOUNT_JSON_PATH=
GCP_ORG_ID=

# ---- Safety switch for real gcloud writes ----
# LEAVE FALSE for hackathon demo. When false, RemediationAgent shows the
# gcloud command it would run but does not execute it against your project.
FLEETOPS_ALLOW_REAL_REMEDIATION=false
